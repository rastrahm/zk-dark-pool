# Copiar a `.env` y rellenar. Nunca commitear secretos.
MAINNET_RPC_URL=
SEPOLIA_RPC_URL=
PRIVATE_KEY=

# Token ERC-20 del pool (address). Vacio = ETH nativo en lab (Fase 2+).
POOL_TOKEN=

# Profundidad Merkle de saldos / notas (debe coincidir con el circuito cuando exista).
MERKLE_TREE_LEVELS=4

# Ruta opcional a powersOfTau (si falta, scripts de lab pueden generar ptau local).
# PTAU_PATH=
